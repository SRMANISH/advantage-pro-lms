# Copy to .env and adjust. Never commit the real .env.

DEBUG=true
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database — PostgreSQL in real environments. Leave unset to use local SQLite for quick dev.
# DATABASE_URL=postgres://lms:lms@localhost:5432/advantage_pro_lms

# Reverse proxies in front of Django. Controls how far X-Forwarded-For is trusted, for both
# audit-log IPs and DRF's per-IP throttles. 0 = Django exposed directly, header ignored.
# Set to 1 behind the documented nginx setup (deploy/nginx.conf); 2 if a CDN sits in front.
# Do not guess high: every extra hop trusts one more header entry the client can write.
TRUSTED_PROXY_COUNT=0

# Frontend origin (for CORS + CSRF)
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Integration adapters (ports & adapters). Defaults are local/dev stubs.
# Swap these dotted paths for Hostinger / 3rd-party adapters later — no code changes.
LMS_STORAGE_ADAPTER=core.adapters.local.LocalStorageAdapter
LMS_EMAIL_ADAPTER=core.adapters.local.ConsoleEmailAdapter
LMS_SMS_ADAPTER=core.adapters.local.ConsoleSmsAdapter
LMS_WHATSAPP_ADAPTER=core.adapters.local.ConsoleWhatsAppAdapter
LMS_SCHEDULER_ADAPTER=core.adapters.local.ImmediateScheduler
